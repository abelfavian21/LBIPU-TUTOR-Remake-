APP_NAME="Tutorial LPIDB UMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (default MySQL / XAMPP / Laragon) ---
# Buat dulu database kosong bernama "tutorial_lpidb"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tutorial_lpidb
DB_USERNAME=root
DB_PASSWORD=abelpro

# --- Alternatif tanpa MySQL: pakai SQLite ---
# DB_CONNECTION=sqlite
# (hapus DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD di atas)
# lalu jalankan: touch database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
